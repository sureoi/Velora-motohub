        <a class="btn btn-secondary" href="#how-it-works">
          How It Works
        </a>
      </div>
    </div>
  </header>

  <main class="container">
    <!-- Official URL -->
    <section class="official">
      <h2>Official Teachable Machine Image Library</h2>
      <p style="color: var(--text-muted); margin: 0;">
        This is the canonical source for the Image library used in this motorcycle ride concept. 
        All documentation, source code, and examples live here.
      </p>
      <div class="url-box">
        <a id="repo-url" href="https://github.com/googlecreativelab/teachablemachine-community/tree/master/libraries/image" target="_blank" rel="noopener">
          https://github.com/googlecreativelab/teachablemachine-community/tree/master/libraries/image
        </a>
        <button class="copy-btn" onclick="copyUrl()">Copy link</button>
      </div>
    </section>

    <!-- About the concept -->
    <section class="card">
      <h2>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        About This Motorcycle Ride Concept
